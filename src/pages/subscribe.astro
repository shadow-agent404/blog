---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site.config';

const channels = site.distribution.filter((item) => item.href);
---

<BaseLayout
  title="订阅"
  description="RSS、Atom、JSON Feed 直链，以及各平台主页。"
>
  <section class="masthead">
    <div class="container">
      <h1 class="masthead__title">订阅</h1>
      <p class="masthead__lede">RSS、Atom、JSON，点开就是文件。</p>
    </div>
  </section>

  <div class="container subscribe-page">
    <ul class="feed-list">
      {
        site.feeds.map((feed) => (
          <li class="feed-item">
            <div class="feed-item__head">
              <a class="feed-item__label" href={feed.href}>{feed.label}</a>
              <button
                class="feed-item__copy"
                type="button"
                data-copy-link={feed.href}
                aria-label={`复制 ${feed.label} 链接`}
              >
                <Icon name="copy" size={14} />
                复制
              </button>
            </div>
            <code class="feed-item__url">{site.url}{feed.href}</code>
          </li>
        ))
      }
    </ul>

    {
      channels.length > 0 && (
        <section class="places" aria-labelledby="places-title">
          <h2 id="places-title">其他平台</h2>
          <ul>
            {channels.map((item) => (
              <li>
                <a href={item.href} target="_blank" rel="noopener noreferrer">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .subscribe-page {
    max-width: 44rem;
    padding-block: 1rem clamp(3rem, 7vw, 5rem);
  }

  .feed-list {
    display: grid;
    gap: 0.5rem;
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .feed-item {
    padding: 0.85rem 1rem;
    border: 1px solid var(--rule);
    background: var(--paper-raised);
  }

  .feed-item__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .feed-item__label {
    color: var(--ink);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
  }

  .feed-item__label:hover {
    color: var(--red-strong);
  }

  .feed-item__url {
    display: block;
    margin-top: 0.35rem;
    overflow: hidden;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .feed-item__copy {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    flex: none;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    background: var(--paper);
    color: var(--ink-2);
    font-size: 0.72rem;
    cursor: pointer;
  }

  .feed-item__copy:hover {
    border-color: var(--ink-3);
    color: var(--ink);
  }

  .places {
    margin-top: 2.4rem;
  }

  .places h2 {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .places ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    margin-top: 0.9rem;
    padding: 0;
    list-style: none;
  }

  .places a {
    color: var(--ink-2);
    font-size: 0.88rem;
    text-decoration: none;
  }

  .places a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
</style>
