---
import { render } from 'astro:content';
import fs from 'node:fs';
import 'katex/dist/katex.min.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Toc from '../../components/Toc.astro';
import ShareLinks from '../../components/ShareLinks.astro';
import ShareDialog from '../../components/ShareDialog.astro';
import BookmarkButton from '../../components/BookmarkButton.astro';
import LikeButton from '../../components/LikeButton.astro';
import Comments from '../../components/Comments.astro';
import ReadingAids from '../../components/ReadingAids.astro';
import Mermaid from '../../components/Mermaid.astro';
import PostCard from '../../components/PostCard.astro';
import { categories, categoryLabel, languageLabel, tagToSlug } from '../../data/taxonomy';
import {
  formatDate,
  getPosts,
  readingMinutes,
  relatedPosts,
  seriesPosts,
  type Post,
} from '../../lib/posts';
import { site } from '../../site.config';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const allPosts = await getPosts();
const index = allPosts.findIndex((item) => item.id === post.id);
const newer = index > 0 ? allPosts[index - 1] : undefined;
const older = index < allPosts.length - 1 ? allPosts[index + 1] : undefined;
const related = relatedPosts(post, allPosts, 3);
const series = seriesPosts(allPosts, post.data.series);
const seriesIndex = series.findIndex((item) => item.id === post.id);
const reading = readingMinutes(post.body ?? '');

const category = categories[post.data.category];
const canonical = new URL(Astro.url.pathname, site.url).href;
const rawPath = `/raw/${post.id}.md`;
const editUrl = `${site.repoUrl}/edit/main/src/content/posts/${post.id}.md`;
const syncTargets = site.distribution.filter((item) => item.href);
const ogPath = fs.existsSync(`./public/og/${post.id}.png`)
  ? `/og/${post.id}.png`
  : '/og/default.png';
const ogImage = new URL(ogPath, site.url).href;
const lang = post.data.lang;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated ?? post.data.date).toISOString(),
  inLanguage: lang === 'en' ? 'en' : 'zh-CN',
  author: {
    '@type': 'Person',
    name: site.author,
    alternateName: site.handle,
    url: site.url,
  },
  publisher: {
    '@type': 'Organization',
    name: site.name,
    url: site.url,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonical,
  },
  image: ogImage,
  url: canonical,
  keywords: post.data.tags.join(', '),
  articleSection: categoryLabel(post.data.category, 'zh'),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: site.url },
    { '@type': 'ListItem', position: 2, name: '文章', item: new URL('/blog/', site.url).href },
    {
      '@type': 'ListItem',
      position: 3,
      name: post.data.title,
      item: canonical,
    },
  ],
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={ogPath}
  type="article"
  lang={lang}
  jsonLd={[articleLd, breadcrumbLd]}
>
  <article lang={lang === 'en' ? 'en' : 'zh-CN'} data-article-slug={post.id}>
    <header class="article-head container">
      <nav class="breadcrumb" aria-label="面包屑">
        <a href="/">首页</a>
        <span aria-hidden="true">/</span>
        <a href="/blog/">文章</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{categoryLabel(post.data.category)}</span>
      </nav>

      <div class="article-head__meta">
        <a class="chip" data-tone={category.tone} href={`/categories/${post.data.category}/`}>
          {categoryLabel(post.data.category)}
        </a>
        <span class="lang-tag">{languageLabel(lang)}</span>
        {post.data.featured && <span class="article-head__featured">精选</span>}
      </div>

      {
        post.data.series && (
          <p class="article-series">
            收录于专题
            <a href="/#issue">《{post.data.series}》</a>
            <span>
              {String(seriesIndex + 1).padStart(2, '0')} / {String(series.length).padStart(2, '0')}
            </span>
          </p>
        )
      }

      <h1 class="article-head__title">{post.data.title}</h1>
      <p class="article-head__desc">{post.data.description}</p>

      <div class="article-head__foot">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
        <span aria-hidden="true">·</span>
        <span>{reading} 分钟</span>
        <span aria-hidden="true">·</span>
        <span>{lang === 'en' ? 'Written in English' : '用中文写作'}</span>
        <span aria-hidden="true">·</span>
        <span>{post.data.tags.length} 个标签</span>
      </div>
    </header>

    <div class="article-divider container" aria-hidden="true">
      <span></span>
    </div>

    <div class="article-layout container">
      <aside class="article-share" aria-label="分享这篇文章">
        <ShareLinks title={post.data.title} url={canonical} vertical />
      </aside>

      <div class="article-main">
        <details class="mobile-toc">
          <summary>
            <span>展开目录</span>
            <Icon name="chevron-down" size={16} />
          </summary>
          <Toc headings={headings} label="文章目录（移动端）" compact />
        </details>

        <div
          class="prose"
          id="article-body"
          data-reading-body
          data-reading-size="md"
        >
          <Content />
        </div>

        <footer class="article-footer">
          <ul class="article-tags" aria-label="文章标签">
            {
              post.data.tags.map((tag) => (
                <li>
                  <a class="tag" href={`/tags/${tagToSlug(tag)}/`}>#{tag}</a>
                </li>
              ))
            }
          </ul>

          <div class="article-actions">
            <LikeButton slug={post.id} />
            <BookmarkButton slug={post.id} />
            <ShareLinks title={post.data.title} url={canonical} />
          </div>
        </footer>

        <section class="publish-panel" aria-labelledby="publish-title">
          <header class="publish-panel__head">
            <p class="kicker">分发 / Distribute</p>
            <h2 class="publish-panel__title" id="publish-title">把这篇带走</h2>
            <p class="publish-panel__desc">
              复制 Markdown 去别处继续写，下载源文件离线保存，或者直接生成一张卡片发到社交平台。
            </p>
          </header>

          <div class="publish-actions">
            <button class="publish-action" type="button" data-copy-md data-raw={rawPath}>
              <span class="publish-action__icon"><Icon name="copy" size={17} /></span>
              <span class="publish-action__body">
                <strong>复制 Markdown</strong>
                <small>带标题、标签与正文</small>
              </span>
            </button>

            <a class="publish-action" href={rawPath} download={`${post.id}.md`}>
              <span class="publish-action__icon"><Icon name="download" size={17} /></span>
              <span class="publish-action__body">
                <strong>下载 .md</strong>
                <small>原始 Markdown 文件</small>
              </span>
            </a>

            <a class="publish-action" href={rawPath} target="_blank" rel="noopener noreferrer">
              <span class="publish-action__icon"><Icon name="external" size={17} /></span>
              <span class="publish-action__body">
                <strong>查看纯文本</strong>
                <small>浏览器直接打开</small>
              </span>
            </a>

            <a class="publish-action" href={editUrl} target="_blank" rel="noopener noreferrer">
              <span class="publish-action__icon"><Icon name="edit" size={17} /></span>
              <span class="publish-action__body">
                <strong>在 GitHub 编辑</strong>
                <small>提 PR 修正错字</small>
              </span>
            </a>

            <button class="publish-action publish-action--accent" type="button" data-share-open>
              <span class="publish-action__icon"><Icon name="share" size={17} /></span>
              <span class="publish-action__body">
                <strong>生成分享卡片</strong>
                <small>横版 / 竖版 + 二维码</small>
              </span>
            </button>
          </div>

          {
            syncTargets.length > 0 && (
              <div class="publish-sync">
                <span class="publish-sync__label">同步到</span>
                <ul>
                  {syncTargets.map((item) => (
                    <li>
                      <a href={item.href} target="_blank" rel="noopener noreferrer">
                        {item.label}
                        <span>{item.kind}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </section>

        <Comments />
      </div>

      <aside class="article-toc" aria-label="文章目录">
        <Toc headings={headings} />
      </aside>
    </div>

    {
      series.length > 1 && (
        <nav class="series-nav container" aria-label={`专题《${post.data.series}》`}>
          <div class="series-nav__head">
            <div>
              <p class="kicker">同专题</p>
              <h2>《{post.data.series}》</h2>
            </div>
            <span class="series-nav__count">
              {String(seriesIndex + 1).padStart(2, '0')} / {String(series.length).padStart(2, '0')}
            </span>
          </div>
          <ol>
            {series.map((item, index) => (
              <li>
                <a
                  href={`/blog/${item.id}/`}
                  aria-current={item.id === post.id ? 'page' : undefined}
                >
                  <span class="series-nav__no">{String(index + 1).padStart(2, '0')}</span>
                  <span class="series-nav__title">{item.data.title}</span>
                  <span class="series-nav__meta">{readingMinutes(item.body ?? '')} 分钟</span>
                  <Icon name="arrow-right" size={15} />
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    {
      (newer || older) && (
        <nav class="article-pager container" aria-label="文章翻页">
          {newer && (
            <a class="pager-card pager-card--next" href={`/blog/${newer.id}/`}>
              <span class="pager-card__label">较新文章</span>
              <span class="pager-card__title">{newer.data.title}</span>
              <span class="pager-card__meta">{formatDate(newer.data.date, newer.data.lang)}</span>
            </a>
          )}
          {older && (
            <a class="pager-card pager-card--prev" href={`/blog/${older.id}/`}>
              <span class="pager-card__label">较早文章</span>
              <span class="pager-card__title">{older.data.title}</span>
              <span class="pager-card__meta">{formatDate(older.data.date, older.data.lang)}</span>
            </a>
          )}
        </nav>
      )
    }

    {
      related.length > 0 && (
        <section class="article-related container" aria-labelledby="related-title">
          <header class="related-head">
            <div>
              <p class="kicker">更多文章</p>
              <h2 id="related-title" class="related-head__title">相关文章</h2>
            </div>
            <a class="arrow-link" href="/blog/">
              全部文章
              <Icon name="arrow-right" size={16} />
            </a>
          </header>

          <div class="related-grid">
            {related.map((item, i) => (
              <PostCard post={item} index={i} />
            ))}
          </div>
        </section>
      )
    }
  </article>

  <ShareDialog
    title={post.data.title}
    url={canonical}
    description={post.data.description}
    tags={post.data.tags}
    category={categoryLabel(post.data.category)}
    date={formatDate(post.data.date, lang)}
    author={site.author}
    slug={post.id}
  />

  <ReadingAids />
  <Mermaid />
</BaseLayout>

<style>
  .article-head {
    max-width: 54rem;
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }

  .breadcrumb a {
    color: var(--ink-3);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--blue-strong);
    text-decoration: underline;
  }

  .breadcrumb [aria-current='page'] {
    color: var(--ink-2);
  }

  .article-head__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.6rem;
  }

  .article-head__meta .chip {
    text-decoration: none;
  }

  .article-series {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    color: var(--ink-3);
  }

  .article-series a {
    color: var(--clay);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--clay) 40%, transparent);
  }

  .article-series a:hover {
    border-bottom-color: var(--clay);
  }

  .article-series span {
    opacity: 0.72;
  }

  .article-head__featured {
    padding: 0.12rem 0.45rem;
    border: 1px solid var(--sand);
    color: var(--sand);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
  }

  .article-head__title {
    margin-top: 1rem;
    font-size: clamp(2.2rem, 5.4vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .article-head__desc {
    max-width: 42rem;
    margin-top: 1.2rem;
    color: var(--ink-3);
    font-size: clamp(0.98rem, 1.5vw, 1.08rem);
    line-height: 1.85;
    text-wrap: pretty;
  }

  .article-head__foot {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.8rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--rule-soft);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }

  .article-divider {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    max-width: 54rem;
    margin-block: clamp(2rem, 4vw, 3rem);
  }

  .article-divider::before,
  .article-divider::after {
    content: '';
    height: 1px;
    flex: 1;
    background: var(--rule);
    opacity: 0.7;
  }

  .article-divider span {
    width: 0.55rem;
    height: 0.55rem;
    background: var(--blue);
    transform: rotate(45deg);
  }

  .article-layout {
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 46rem) 12.5rem;
    justify-content: space-between;
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: start;
  }

  .article-main {
    min-width: 0;
  }

  .article-toc {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    max-height: calc(100vh - var(--header-h) - 4rem);
    overflow-y: auto;
    padding-right: 0.4rem;
  }

  .mobile-toc {
    display: none;
    margin-bottom: 2rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper-raised);
  }

  .mobile-toc summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    cursor: pointer;
    list-style: none;
  }

  .mobile-toc summary::-webkit-details-marker {
    display: none;
  }

  .mobile-toc[open] summary svg {
    transform: rotate(180deg);
  }

  .mobile-toc summary svg {
    transition: transform 0.25s var(--ease);
  }

  .mobile-toc :global(.toc) {
    padding: 0 1rem 1rem;
  }

  .prose[data-reading-size='sm'] {
    font-size: 0.96rem;
  }

  .prose[data-reading-size='md'] {
    font-size: 1.0625rem;
  }

  .prose[data-reading-size='lg'] {
    font-size: 1.2rem;
  }

  .article-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: 1.4rem;
    border-top: 1px solid var(--rule-soft);
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .article-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  /* 分发面板 */
  .publish-panel {
    margin-top: clamp(2rem, 4vw, 3rem);
    padding: clamp(1.2rem, 3vw, 1.8rem);
    border: 1px solid var(--ink);
    background: var(--paper-raised);
  }

  .publish-panel__head {
    padding-bottom: 0.9rem;
    border-bottom: 3px solid var(--ink);
  }

  .publish-panel__title {
    margin-top: 0.4rem;
    font-size: clamp(1.25rem, 2.6vw, 1.7rem);
    letter-spacing: -0.03em;
  }

  .publish-panel__desc {
    max-width: 40rem;
    margin-top: 0.5rem;
    color: var(--ink-3);
    font-size: 0.82rem;
    line-height: 1.75;
  }

  .publish-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .publish-action {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.6rem 0.7rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    background: var(--paper);
    color: var(--ink);
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.2s var(--ease), background 0.2s var(--ease),
      transform 0.2s var(--ease);
  }

  .publish-action:hover {
    border-color: var(--ink);
    transform: translateY(-1px);
  }

  .publish-action__icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    flex: none;
    border: 1px solid var(--rule);
    color: var(--ink-2);
  }

  .publish-action__body {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    min-width: 0;
  }

  .publish-action__body strong {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
  }

  .publish-action__body small {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.54rem;
    letter-spacing: 0.04em;
  }

  .publish-action--accent {
    border-color: var(--red);
    background: var(--red);
    color: var(--paper-raised);
  }

  .publish-action--accent:hover {
    border-color: var(--red-strong);
    background: var(--red-strong);
  }

  .publish-action--accent .publish-action__icon {
    border-color: color-mix(in srgb, var(--paper-raised) 45%, transparent);
    color: var(--paper-raised);
  }

  .publish-action--accent .publish-action__body small {
    color: color-mix(in srgb, var(--paper-raised) 78%, transparent);
  }

  .publish-sync {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1rem;
    padding-top: 0.9rem;
    border-top: 1px dashed var(--rule);
  }

  .publish-sync__label {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .publish-sync ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .publish-sync a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-decoration: none;
    transition: border-color 0.2s var(--ease), color 0.2s var(--ease);
  }

  .publish-sync a:hover {
    border-color: var(--red);
    color: var(--red-strong);
  }

  .publish-sync a span {
    color: var(--ink-3);
    font-size: 0.5rem;
  }

  @media (max-width: 620px) {
    .publish-actions {
      grid-template-columns: 1fr;
    }
  }

  /* 专题导航 */
  .series-nav {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: 1.3rem;
    border-top: 1px solid var(--rule);
  }

  .series-nav__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.7rem;
  }

  .series-nav__head h2 {
    margin-top: 0.45rem;
    font-size: clamp(1.35rem, 2.6vw, 1.8rem);
    letter-spacing: -0.025em;
  }

  .series-nav__count {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    color: var(--ink-3);
  }

  .series-nav ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .series-nav li {
    border-bottom: 1px dashed var(--rule-soft);
  }

  .series-nav li:last-child {
    border-bottom: 0;
  }

  .series-nav a {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto auto;
    align-items: baseline;
    gap: 0.8rem;
    padding: 0.8rem 0.2rem;
    color: var(--ink-2);
    text-decoration: none;
    transition: color 0.2s var(--ease);
