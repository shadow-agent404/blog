</style>

<script>
  import { bootAccount, recordView } from '../../lib/account-client';

  const article = document.querySelector<HTMLElement>('[data-article-slug]');
  const slug = article?.dataset.articleSlug;

  if (slug) {
    bootAccount().then(() => recordView(slug));
  }

  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-md]');

  if (copyButton) {
    const copyText = async (text: string) => {
      if (navigator.clipboard && window.isSecureContext) {
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch {
          /* 回退到 execCommand */
        }
      }

      const area = document.createElement('textarea');
      area.value = text;
      area.setAttribute('readonly', '');
      area.style.position = 'fixed';
      area.style.top = '-9999px';
      document.body.appendChild(area);
      area.select();
      let copied = false;
      try {
        copied = document.execCommand('copy');
      } catch {
        copied = false;
      }
      area.remove();
      return copied;
    };

    const original = copyButton.querySelector('strong')?.textContent ?? '复制 Markdown';

    copyButton.addEventListener('click', async () => {
      const raw = copyButton.dataset.raw;
      if (!raw) return;

      try {
        const response = await fetch(raw, { headers: { accept: 'text/markdown' } });
        if (!response.ok) throw new Error('fetch failed');
        const markdown = await response.text();
        const copied = await copyText(markdown);
        const label = copyButton.querySelector('strong');
        if (label) label.textContent = copied ? '已复制 Markdown' : '复制失败';

        window.setTimeout(() => {
          if (label) label.textContent = original;
        }, 2200);
      } catch {
        window.open(raw, '_blank', 'noopener');
      }
    });
  }
</script>
