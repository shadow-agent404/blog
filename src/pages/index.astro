---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import VideoCard from '../components/VideoCard.astro';
import VideoPlayer from '../components/VideoPlayer.astro';
import RepoRow from '../components/RepoRow.astro';
import videosData from '../data/videos.json';
import reposData from '../data/repos.json';
import { categoryLabel } from '../data/taxonomy';
import { categoryCounts, getPosts, getProjects } from '../lib/posts';
import { site } from '../site.config';

const posts = await getPosts();
const projects = await getProjects();
const videos = videosData.videos.slice(0, 3);
const repos = reposData.repos.slice(0, 5);

const cats = categoryCounts(posts);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  alternateName: site.nameEn,
  url: site.url,
  description: site.description,
  inLanguage: 'zh-CN',
  author: {
    '@type': 'Person',
    name: site.author,
    alternateName: site.handle,
    url: site.url,
    description: site.descriptionEn,
  },
};
---

<BaseLayout jsonLd={jsonLd}>
  <section class="masthead">
    <div class="container">
      <h1 class="masthead__title">sa</h1>
      <p class="masthead__lede">{site.tagline}</p>

      <form class="journal-search" action="/search/" method="get" role="search">
          <label class="visually-hidden" for="home-search">搜索文章</label>
          <span class="journal-search__icon" aria-hidden="true">
            <Icon name="search" size={18} />
          </span>
          <input
            id="home-search"
            type="search"
            name="q"
            placeholder="搜索文章、标签或关键词…"
            autocomplete="off"
          />
          <button type="submit" aria-label="搜索">
            <Icon name="arrow-right" size={17} />
          </button>
        </form>

        <nav class="pill-nav masthead__pills" aria-label="内容分类">
          <a class="pill" href="/blog/">全部 <span class="pill__count">{posts.length}</span></a>
          {
            cats.map((cat) => (
              <a class="pill" href={`/categories/${cat.key}/`}>
                {categoryLabel(cat.key)}
                <span class="pill__count">{cat.count}</span>
              </a>
            ))
          }
        </nav>
    </div>
  </section>

  {
    posts.length === 0 && (
      <section class="container home-empty" aria-labelledby="home-empty-title">
        <div class="home-empty__card">
          <h2 id="home-empty-title">暂无文章</h2>
          <div class="home-empty__actions">
            <a class="btn btn--ghost" href="/projects/">查看项目</a>
            <a class="btn btn--ghost" href="/about/">查看个人信息</a>
          </div>
        </div>
      </section>
    )
  }

  {
    posts.length > 0 && (
      <section class="container journal-section" aria-labelledby="latest-title">
        <header class="section-head">
          <h2 id="latest-title" class="section-head__title">文章</h2>
          <a class="arrow-link" href="/blog/">
            全部 {posts.length} 篇
            <Icon name="arrow-right" size={15} />
          </a>
        </header>

        <div class="post-carousel">
          <button
            class="carousel-btn carousel-btn--prev"
            type="button"
            data-carousel-prev
            aria-label="上一篇"
          >
            <Icon name="chevron-right" size={18} />
          </button>

          <div class="post-rail" data-post-rail tabindex="0" aria-label="文章列表，可左右滑动">
            {posts.map((post, index) => (
              <div class="post-rail__item" data-carousel-item>
                <PostCard post={post} index={index + 1} />
              </div>
            ))}
          </div>

          <button
            class="carousel-btn carousel-btn--next"
            type="button"
            data-carousel-next
            aria-label="下一篇"
          >
            <Icon name="chevron-right" size={18} />
          </button>
        </div>
      </section>
    )
  }

  <section class="container more-section" aria-label="项目">
    <div class="more-col">
      <div class="more-head">
        <h2>项目</h2>
        <a class="arrow-link" href="/projects/">
          全部项目
          <Icon name="arrow-right" size={15} />
        </a>
      </div>
      <ul class="more-list">
        {
          projects.slice(0, 4).map((project) => (
            <li data-reveal>
              <a href={`/projects/${project.id}/`}>
                <span class="more-list__year">{project.data.year}</span>
                <span class="more-list__title">{project.data.title}</span>
                <span class="more-list__meta">{project.data.status}</span>
                <span class="more-list__arrow" aria-hidden="true">
                  <Icon name="arrow-right" size={15} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    videos.length > 0 && (
      <section class="container home-media" aria-labelledby="home-videos-title">
        <div class="more-head">
          <h2 id="home-videos-title">视频</h2>
          <a class="arrow-link" href="/videos/">
            全部视频
            <Icon name="arrow-right" size={15} />
          </a>
        </div>
        <div class="home-video-grid">
          {videos.map((video) => <VideoCard video={video} />)}
        </div>
      </section>
    )
  }

  {
    repos.length > 0 && (
      <section class="container home-repos" aria-labelledby="home-repos-title">
        <div class="more-head">
          <h2 id="home-repos-title">开源</h2>
          <a class="arrow-link" href="/repos/">
            全部仓库
            <Icon name="arrow-right" size={15} />
          </a>
        </div>
        <ul class="home-repo-list">
          {repos.map((repo) => <RepoRow repo={repo} />)}
        </ul>
      </section>
    )
  }

  <VideoPlayer />
</BaseLayout>

<style>
  .journal-section {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  .post-carousel {
    position: relative;
    margin-top: 1.4rem;
  }

  .post-rail {
    --rail-card: min(32rem, 74vw);
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: var(--rail-card);
    gap: 1rem;
    padding: 0.4rem calc((100% - var(--rail-card)) / 2) 0.9rem;
    overflow-x: auto;
    cursor: grab;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .post-rail::-webkit-scrollbar {
    display: none;
  }

  .post-rail:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 4px;
  }

  .post-rail__item {
    scroll-snap-align: center;
    opacity: 0.4;
    transform: scale(0.95);
    transition: opacity 0.4s var(--ease), transform 0.4s var(--ease);
  }

  .post-rail__item.is-active {
    opacity: 1;
    transform: none;
  }

  .carousel-btn {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: var(--paper-raised);
    color: var(--ink-2);
    box-shadow: var(--shadow);
    cursor: pointer;
    transform: translateY(-50%);
    transition: background 0.2s var(--ease), color 0.2s var(--ease);
  }

  .carousel-btn:hover {
    background: var(--ink);
    color: var(--paper-raised);
  }

  .carousel-btn:disabled {
    opacity: 0;
    pointer-events: none;
  }

  .carousel-btn--prev {
    left: 0.6rem;
  }

  .carousel-btn--prev :global(svg) {
    transform: rotate(180deg);
  }

  .carousel-btn--next {
    right: 0.6rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .post-rail {
      scroll-behavior: auto;
    }

    .post-rail__item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  @media (max-width: 760px) {
    .post-rail {
      --rail-card: 84%;
    }

    .carousel-btn {
      width: 2rem;
      height: 2rem;
    }

    .carousel-btn--prev {
      left: 0.15rem;
    }

    .carousel-btn--next {
      right: 0.15rem;
    }
  }

  .home-media {
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  .home-video-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.2rem, 2.6vw, 2rem);
    margin-top: 1.4rem;
  }

  .home-repos {
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  .home-repo-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  @media (max-width: 860px) {
    .home-video-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .home-video-grid {
      grid-template-columns: 1fr;
    }
  }

  .home-empty {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  .home-empty__card {
    padding: clamp(1.6rem, 4vw, 2.6rem);
    border: 1px solid var(--rule);
    background: var(--paper-raised);
    box-shadow: var(--shadow);
  }

  .home-empty__card h2 {
    margin-top: 0.5rem;
    font-size: clamp(1.5rem, 3.4vw, 2.1rem);
  }

  .home-empty__card p {
    max-width: 32rem;
    margin-top: 0.6rem;
    color: var(--ink-3);
  }

  .home-empty__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.2rem;
  }

  .entry-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: 2.6rem;
    padding-top: 1.2rem;
    border-top: 3px solid var(--ink);
    text-align: left;
  }

  .entry-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.2rem 2.2rem 0.2rem 0;
    color: var(--ink);
    text-decoration: none;
  }

  .entry-card__top {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .entry-card__index {
    color: var(--red);
  }

  .entry-card__title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
    transition: color 0.25s var(--ease);
  }

  .entry-card__meta {
    font-size: 0.72rem;
    color: var(--ink-3);
  }

  .entry-card__arrow {
    position: absolute;
    top: 1.35rem;
    right: 0;
    display: inline-flex;
    color: var(--ink-3);
    transition: transform 0.25s var(--ease), color 0.25s var(--ease);
  }

  .entry-card:hover .entry-card__title {
    color: var(--red-strong);
  }

  .entry-card:hover .entry-card__arrow {
    transform: translateX(4px);
    color: var(--red-strong);
  }

  .journal-section {
    padding-top: 0;
  }

  .more-section {
    margin-top: clamp(3.5rem, 8vw, 6rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--rule-soft);
  }

  @media (max-width: 900px) {
    .entry-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem 1.5rem;
    }
  }

  @media (max-width: 700px) {
    .masthead__pills {
      justify-content: flex-start;
    }

    .entry-grid {
      grid-template-columns: 1fr;
      gap: 0;
      margin-top: 1.7rem;
    }

    .entry-card {
      padding: 0.85rem 2.2rem 0.9rem 0;
      border-bottom: 1px dashed var(--rule-soft);
    }

    .entry-card:last-child {
      border-bottom: 0;
      padding-bottom: 0;
    }

    .entry-card__title {
      font-size: 1.12rem;
    }

    .entry-card__meta {
      font-size: 0.7rem;
    }

    .entry-card__arrow {
      top: 1.15rem;
    }
  }
</style>

<script>
  const rail = document.querySelector<HTMLElement>('[data-post-rail]');
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-carousel-item]'));
  const prev = document.querySelector<HTMLButtonElement>('[data-carousel-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-carousel-next]');

  if (rail && items.length > 0) {
    let active = 0;

    const centerOf = (item: HTMLElement) => item.offsetLeft + item.offsetWidth / 2;

    const setActive = (index: number, scroll = false) => {
      active = Math.max(0, Math.min(items.length - 1, index));
      items.forEach((item, i) => item.classList.toggle('is-active', i === active));
      if (prev) prev.disabled = active === 0;
      if (next) next.disabled = active === items.length - 1;
      if (scroll) {
        rail.scrollTo({
          left: centerOf(items[active]) - rail.clientWidth / 2,
          behavior: 'smooth',
        });
      }
    };

    const syncToScroll = () => {
      const middle = rail.scrollLeft + rail.clientWidth / 2;
      let best = 0;
      let distance = Infinity;
      items.forEach((item, i) => {
        const delta = Math.abs(centerOf(item) - middle);
        if (delta < distance) {
          distance = delta;
          best = i;
        }
      });
      setActive(best);
    };

    let frame = 0;
    rail.addEventListener(
      'scroll',
      () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(syncToScroll);
      },
      { passive: true },
    );

    prev?.addEventListener('click', () => setActive(active - 1, true));
    next?.addEventListener('click', () => setActive(active + 1, true));

    rail.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        setActive(active - 1, true);
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        setActive(active + 1, true);
      }
    });

    let dragging = false;
    let moved = false;
    let startX = 0;
    let startScroll = 0;

    rail.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'mouse') return;
      dragging = true;
      moved = false;
      startX = event.clientX;
      startScroll = rail.scrollLeft;
      rail.setPointerCapture(event.pointerId);
      rail.style.cursor = 'grabbing';
    });

    rail.addEventListener('pointermove', (event) => {
      if (!dragging) return;
      const delta = event.clientX - startX;
      if (Math.abs(delta) > 4) moved = true;
      rail.scrollLeft = startScroll - delta;
    });

    const stopDrag = () => {
      dragging = false;
      rail.style.cursor = '';
    };

    rail.addEventListener('pointerup', stopDrag);
    rail.addEventListener('pointercancel', stopDrag);
    rail.addEventListener('dragstart', (event) => event.preventDefault());
    rail.addEventListener(
      'click',
      (event) => {
        if (!moved) return;
        event.preventDefault();
        event.stopPropagation();
      },
      true,
    );

    setActive(0, true);
    window.addEventListener('resize', () => setActive(active, true));
  }

</script>

<script>
  import '../scripts/reveal';
</script>
