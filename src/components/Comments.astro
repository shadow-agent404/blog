---
import { site } from '../site.config';

const configured = Boolean(
  site.giscus.repo && site.giscus.repoId && site.giscus.categoryId,
);
---

<section class="comments" aria-labelledby="comments-title">
  <div class="comments__head">
    <p class="kicker">讨论</p>
    <h2 id="comments-title" class="comments__title">说点什么</h2>
  </div>

  <div class="comment-identity" data-comment-identity>
    <span class="comment-identity__avatar" data-identity-avatar aria-hidden="true">S</span>
    <div class="comment-identity__body">
      <strong data-identity-name>以访客身份浏览</strong>
      <small data-identity-note>登录后可收藏、同步点赞。评论由 Giscus 发布，使用 GitHub 身份。</small>
    </div>
    <a class="comment-identity__link" data-identity-link href="/login/">登录</a>
  </div>

  {
    configured ? (
      <div
        class="giscus"
        data-giscus
        data-repo={site.giscus.repo}
        data-repo-id={site.giscus.repoId}
        data-category={site.giscus.category}
        data-category-id={site.giscus.categoryId}
      />
    ) : (
      <p class="comments__placeholder">
        评论区已经预留好位置。在 <code>src/site.config.ts</code> 里填入 Giscus
        配置后，这里会自动出现讨论。
      </p>
    )
  }
</section>

<style>
  .comments {
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--rule-soft);
  }

  .comments__head {
    margin-bottom: 1.5rem;
  }

  .comments__title {
    margin-top: 0.5rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .giscus {
    min-height: 8rem;
  }

  .comments__placeholder {
    padding: 1.5rem 1.6rem;
    border: 1px dashed var(--rule);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--paper-raised) 70%, transparent);
    color: var(--ink-3);
    font-size: 0.88rem;
    line-height: 1.8;
  }

  .comments__placeholder code {
    padding: 0.1em 0.35em;
    background: var(--paper-sunk);
    font-family: var(--font-mono);
    font-size: 0.84em;
  }

  .comment-identity {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 1.2rem;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--rule);
    background: var(--paper-raised);
  }

  .comment-identity__avatar {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    flex: none;
    overflow: hidden;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper-raised);
    font-family: var(--font-display);
    font-size: 0.9rem;
  }

  .comment-identity__avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .comment-identity__body {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }

  .comment-identity__body strong {
    font-family: var(--font-sans);
    font-size: 0.76rem;
    font-weight: 600;
  }

  .comment-identity__body small {
    color: var(--ink-3);
    font-size: 0.64rem;
    line-height: 1.5;
  }

  .comment-identity__link {
    margin-left: auto;
    flex: none;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--ink);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: background 0.2s var(--ease), color 0.2s var(--ease);
  }

  .comment-identity__link:hover {
    background: var(--ink);
    color: var(--paper-raised);
  }
</style>

<script>
  import { bootAccount, subscribeAccount, type AccountData } from '../lib/account-client';

  const identity = document.querySelector<HTMLElement>('[data-comment-identity]');

  if (identity) {
    const avatar = identity.querySelector<HTMLElement>('[data-identity-avatar]');
    const name = identity.querySelector<HTMLElement>('[data-identity-name]');
    const note = identity.querySelector<HTMLElement>('[data-identity-note]');
    const link = identity.querySelector<HTMLAnchorElement>('[data-identity-link]');

    const render = (state: AccountData) => {
      const { user } = state;
      if (user) {
        if (name) name.textContent = user.name || '已登录';
        if (note) note.textContent = `通过 ${user.providerName} 登录。评论仍由 Giscus 使用 GitHub 身份发布。`;
        if (link) {
          link.textContent = '我的账号';
          link.href = '/account/';
        }
        if (avatar) {
          avatar.innerHTML = user.avatar
            ? `<img src="${user.avatar}" alt="" loading="lazy" referrerpolicy="no-referrer" />`
            : (user.name || 'S').slice(0, 1).toUpperCase();
        }
      } else {
        if (name) name.textContent = '以访客身份浏览';
        if (note) note.textContent = '登录后可收藏、同步点赞。评论由 Giscus 发布，使用 GitHub 身份。';
        if (link) {
          link.textContent = '登录';
          link.href = '/login/';
        }
        if (avatar) avatar.textContent = 'S';
      }
    };

    subscribeAccount(render);
    bootAccount();
  }
</script>


<script>
  const container = document.querySelector<HTMLElement>('[data-giscus]');

  if (container) {
    let loaded = false;

    const load = () => {
      if (loaded) return;
      loaded = true;

      const theme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
      const script = document.createElement('script');
      script.src = 'https://giscus.app/client.js';
      script.async = true;
      script.crossOrigin = 'anonymous';
      script.dataset.repo = container.dataset.repo ?? '';
      script.dataset.repoId = container.dataset.repoId ?? '';
      script.dataset.category = container.dataset.category ?? '';
      script.dataset.categoryId = container.dataset.categoryId ?? '';
      script.dataset.mapping = 'pathname';
      script.dataset.strict = '0';
      script.dataset.reactionsEnabled = '1';
      script.dataset.emitMetadata = '0';
      script.dataset.inputPosition = 'top';
      script.dataset.theme = theme;
      script.dataset.lang = 'zh-CN';
      script.dataset.loading = 'lazy';

      container.appendChild(script);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          observer.disconnect();
          load();
        }
      },
      { rootMargin: '400px 0px' },
    );

    observer.observe(container);

    document.addEventListener('themechange', (event) => {
      const theme = (event as CustomEvent<{ theme: string }>).detail.theme;
      const frame = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
      frame?.contentWindow?.postMessage(
        { giscus: { setConfig: { theme } } },
        'https://giscus.app',
      );
    });
  }
</script>
