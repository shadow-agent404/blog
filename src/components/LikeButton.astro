---
import Icon from './Icon.astro';
import { site } from '../site.config';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<button
  class="like-btn"
  type="button"
  data-like
  data-slug={slug}
  data-endpoint={site.likesEndpoint}
  aria-pressed="false"
  aria-label="喜欢这篇文章"
>
  <span class="like-btn__icon"><Icon name="heart" size={16} /></span>
  <span class="like-btn__count" data-like-count>喜欢</span>
</button>
<span class="visually-hidden" role="status" data-like-status></span>

<style>
  .like-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    min-height: 2.35rem;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    background: var(--paper-raised);
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: color 0.22s var(--ease), border-color 0.22s var(--ease),
      background-color 0.22s var(--ease), transform 0.22s var(--ease);
  }

  .like-btn:hover {
    color: var(--red-strong);
    border-color: var(--red);
    background: var(--paper);
    transform: translateY(-1px);
  }

  .like-btn__icon {
    display: inline-flex;
    transition: transform 0.3s var(--ease);
  }

  .like-btn[aria-pressed='true'] {
    color: var(--red-strong);
    border-color: var(--red);
    background: var(--paper);
  }

  .like-btn[aria-pressed='true'] :global(svg path) {
    fill: currentColor;
  }

  .like-btn[aria-pressed='true'] .like-btn__icon {
    transform: scale(1.12);
  }
</style>

<script>
  import {
    applyLike,
    bootAccount,
    getAccount,
    subscribeAccount,
    type AccountData,
  } from '../lib/account-client';

  const button = document.querySelector<HTMLButtonElement>('[data-like]');

  if (button) {
    const slug = button.dataset.slug ?? '';
    const endpoint = button.dataset.endpoint ?? '/api/likes';
    const countEl = button.querySelector<HTMLElement>('[data-like-count]');
    const statusEl = document.querySelector<HTMLElement>('[data-like-status]');

    let liked = false;
    let count = 0;
    let busy = false;

    const render = () => {
      button.setAttribute('aria-pressed', liked ? 'true' : 'false');
      button.setAttribute('aria-label', liked ? '取消喜欢这篇文章' : '喜欢这篇文章');
      if (countEl) countEl.textContent = count > 0 ? String(count) : '喜欢';
    };

    const syncFromState = (state: AccountData) => {
      liked = state.likes.includes(slug);
      render();
    };

    subscribeAccount(syncFromState);
    bootAccount();

    const load = async () => {
      try {
        const response = await fetch(`${endpoint}?slug=${encodeURIComponent(slug)}`, {
          credentials: 'same-origin',
          headers: { accept: 'application/json' },
        });
        if (!response.ok) return;
        const data = (await response.json()) as { count?: number; liked?: boolean };
        if (typeof data.count === 'number') count = data.count;
        if (getAccount().user && typeof data.liked === 'boolean') {
          liked = data.liked;
          applyLike(slug, liked);
        }
        render();
      } catch {
        /* 离线时使用本机状态 */
      }
    };

    button.addEventListener('click', async () => {
      if (busy) return;
      busy = true;

      const next = !liked;
      const previous = count;
      liked = next;
      count = Math.max(0, count + (next ? 1 : -1));
      applyLike(slug, liked);
      render();

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ slug, action: next ? 'like' : 'unlike' }),
        });
        if (!response.ok) throw new Error('request failed');
        const data = (await response.json()) as { count?: number; liked?: boolean };
        if (typeof data.count === 'number') count = data.count;
        if (typeof data.liked === 'boolean') {
          liked = data.liked;
          applyLike(slug, liked);
        }
      } catch {
        count = previous;
        liked = !next;
        applyLike(slug, liked);
      }

      busy = false;
      render();
      if (statusEl) statusEl.textContent = liked ? '已标记喜欢' : '已取消喜欢';
    });

    render();
    load();
  }
</script>
