---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import AccountButton from './AccountButton.astro';

const path = Astro.url.pathname;
const navItems = [
  { href: '/blog/', label: '文章', en: 'Writing' },
  { href: '/projects/', label: '项目', en: 'Projects' },
  { href: '/videos/', label: '视频', en: 'Video' },
  { href: '/repos/', label: '开源', en: 'Open Source' },
  { href: '/about/', label: '关于', en: 'About' },
];

const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="sa 首页">sa</a>

    <nav class="nav" aria-label="主导航">
      {
        navItems.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <a class="icon-link" href="/search/" aria-label="搜索文章" title="搜索">
        <Icon name="search" size={17} />
      </a>
      <a class="subscribe-link" href="/subscribe/">
        <Icon name="rss" size={15} />
        <span>订阅</span>
      </a>
      <AccountButton />
      <ThemeToggle />
      <button
        class="menu-toggle"
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="打开菜单"
      >
        <span class="menu-icon menu-icon--open"><Icon name="menu" size={20} /></span>
        <span class="menu-icon menu-icon--close"><Icon name="close" size={20} /></span>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" data-menu-panel hidden>
    <div class="container">
      <nav aria-label="移动端导航">
        {
          navItems.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
        <a href="/subscribe/">订阅</a>
        <a href="/account/">账号与收藏</a>
        <a href="/search/">搜索</a>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--rule);
    background: color-mix(in srgb, var(--paper) 93%, transparent);
    backdrop-filter: blur(14px) saturate(1.1);
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 3.85rem;
  }

  .brand {
    flex-shrink: 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }

  .brand:hover {
    color: var(--red-strong);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(0.7rem, 1.6vw, 1.35rem);
  }

  .nav a {
    position: relative;
    padding: 0.35rem 0;
    color: var(--ink-2);
    font-size: 0.82rem;
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }

  .nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.1rem;
    height: 2px;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease);
  }

  .nav a:hover {
    color: var(--ink);
  }

  .nav a:hover::after,
  .nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .nav a[aria-current='page'] {
    color: var(--ink);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-shrink: 0;
  }

  .icon-link,
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--ink-2);
    text-decoration: none;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }

  .icon-link:hover,
  .menu-toggle:hover {
    color: var(--red-strong);
    border-color: var(--rule);
    background: var(--paper-raised);
  }

  .subscribe-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    height: 2.2rem;
    padding: 0 0.7rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    color: var(--ink-2);
    font-size: 0.74rem;
    text-decoration: none;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease),
      background 0.2s var(--ease);
  }

  .subscribe-link:hover {
    color: var(--red-strong);
    border-color: var(--red);
    background: var(--paper-raised);
  }

  .menu-toggle {
    display: none;
    padding: 0;
    cursor: pointer;
  }

  .menu-icon {
    display: none;
    line-height: 0;
  }

  .menu-icon--open {
    display: block;
  }

  .menu-toggle[aria-expanded='true'] .menu-icon--open {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] .menu-icon--close {
    display: block;
  }

  .mobile-nav {
    border-top: 1px solid var(--ink);
    padding: 0.4rem 0 1.1rem;
    background: var(--paper);
  }

  .mobile-nav[hidden] {
    display: none;
  }

  .mobile-nav nav {
    display: flex;
    flex-direction: column;
  }

  .mobile-nav a {
    display: block;
    padding: 0.8rem 0.2rem;
    border-bottom: 1px solid var(--rule-soft);
    color: var(--ink-2);
    text-decoration: none;
  }

  .mobile-nav a[aria-current='page'] {
    color: var(--red-strong);
  }

  @media (max-width: 980px) {
    .nav,
    .subscribe-link {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }
  }

  @media (max-width: 620px) {
    .header-inner {
      height: 3.5rem;
    }

    .icon-link {
      width: 2rem;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');

  if (toggle && panel) {
    const close = () => {
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', '打开菜单');
      panel.hidden = true;
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        close();
      } else {
        toggle.setAttribute('aria-expanded', 'true');
        toggle.setAttribute('aria-label', '关闭菜单');
        panel.hidden = false;
      }
    });

    panel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', close);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) {
        close();
        toggle.focus();
      }
    });

    document.addEventListener('click', (event) => {
      if (panel.hidden) return;
      const target = event.target as Node;
      if (!panel.contains(target) && !toggle.contains(target)) {
        close();
      }
    });

    window.matchMedia('(min-width: 981px)').addEventListener('change', (event) => {
      if (event.matches) close();
    });
  }
</script>
