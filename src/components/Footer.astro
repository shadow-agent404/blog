---
import Icon from './Icon.astro';
import { site } from '../site.config';

const year = new Date().getFullYear();
const navItems = [
  { href: '/blog/', label: '文章' },
  { href: '/archive/', label: '归档' },
  { href: '/projects/', label: '项目' },
  { href: '/videos/', label: '视频' },
  { href: '/repos/', label: '开源' },
  { href: '/about/', label: '关于' },
  { href: '/subscribe/', label: '订阅' },
  { href: '/login/', label: '登录' },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-feeds" aria-label="订阅">
      {
        site.feeds.map((feed) => (
          <div class="feed-row">
            <a href={feed.href}>{feed.label}</a>
            <button
              type="button"
              data-copy-link={feed.href}
              aria-label={`复制 ${feed.label} 链接`}
            >
              <Icon name="copy" size={13} />
            </button>
          </div>
        ))
      }
    </div>

    <nav class="footer-nav" aria-label="页脚导航">
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="footer-bottom">
      <span>© {year} sa</span>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>

  <div class="copy-toast" data-copy-toast role="status" aria-live="polite" hidden>链接已复制</div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(3rem, 8vw, 6rem);
    padding: 1.6rem 0 2rem;
    border-top: 1px solid var(--rule);
    background: var(--paper-sunk);
  }

  .footer-feeds {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
  }

  .feed-row {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .feed-row a {
    color: var(--ink-2);
    font-size: 0.82rem;
    text-decoration: none;
  }

  .feed-row a:hover {
    color: var(--red-strong);
  }

  .feed-row button {
    display: inline-flex;
    padding: 0.2rem;
    border: 0;
    background: none;
    color: var(--ink-3);
    cursor: pointer;
  }

  .feed-row button:hover {
    color: var(--ink);
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    margin-top: 1.2rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--rule-soft);
  }

  .footer-nav a {
    color: var(--ink-3);
    font-size: 0.8rem;
    text-decoration: none;
  }

  .footer-nav a:hover {
    color: var(--ink);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-top: 1.2rem;
    color: var(--ink-3);
    font-size: 0.72rem;
  }

  .footer-bottom a {
    color: var(--ink-3);
    text-decoration: none;
  }

  .footer-bottom a:hover {
    color: var(--ink);
  }
</style>

<script>
  const toast = document.querySelector<HTMLElement>('[data-copy-toast]');
  let toastTimer = 0;

  const showToast = (message: string) => {
    if (!toast) return;
    toast.textContent = message;
    toast.hidden = false;
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => {
      toast.hidden = true;
    }, 2200);
  };

  document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((button) => {
    button.addEventListener('click', async () => {
      const path = button.dataset.copyLink || '/rss.xml';
      const url = new URL(path, window.location.origin).href;
      try {
        await navigator.clipboard.writeText(url);
        showToast('订阅链接已复制');
      } catch {
        window.prompt('复制这个链接', url);
      }
    });
  });
</script>
